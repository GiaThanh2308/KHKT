# Sao chép file này thành .env rồi điền giá trị thực

# Bắt buộc: khóa bí mật để ký JWT token (đặt chuỗi ngẫu nhiên dài 32+ ký tự)
JWT_SECRET_KEY=your-super-secret-key-change-this

# Bắt buộc: Gemini API key
GEMINI_API_KEY=your-gemini-api-key-here

# Tuỳ chọn: CORS origins cho phép (phân cách bằng dấu phẩy)
# Mặc định: http://127.0.0.1:5500,http://localhost:5500
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Tuỳ chọn: thư mục chứa face_database.pkl và known_faces/
# Mặc định: thư mục "resources/" cạnh main.py
# RESOURCE_DIR=/path/to/your/resources
